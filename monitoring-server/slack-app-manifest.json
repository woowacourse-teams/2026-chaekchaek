{
  "display_information": {
    "name": "책췍 장애 도우미",
    "description": "Grafana 알림 스레드에서 멘션한 질문에 답합니다."
  },
  "features": {
    "bot_user": {
      "display_name": "chaekchaek-bot",
      "always_online": false
    }
  },
  "oauth_config": {
