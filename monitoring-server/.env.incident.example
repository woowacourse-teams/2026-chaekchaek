# 초기에는 비활성으로 배포하고 개발 채널의 원본 알림부터 확인한다.
# LLM_ENABLED=true도 질문이 없으면 모델을 호출하지 않는다.
GRAFANA_WEBHOOK_TOKEN=
SLACK_WEBHOOK_URL_DEV=
SLACK_WEBHOOK_URL_PROD=
# Slack 사용자가 접속할 외부 Grafana 기준 주소다. 대시보드 경로나 쿼리는 넣지 않는다.
GRAFANA_URL=https://api.chaekchaek.com/grafana
ANALYSIS_ENVIRONMENTS=
LLM_ENABLED=false
LLM_URL=https://api.openai.com/v1/responses
LLM_API_KEY=
LLM_MODEL=
LLM_DAILY_CALL_LIMIT=20
INCIDENT_DB_PASSWORD=

SLACK_BOT_ENABLED=false
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_DEV=
SLACK_CHANNEL_PROD=
# 기존 Grafana Incoming Webhook 메시지의 bot_id다. 새 질문 봇의 ID와 구분한다.
SLACK_ALERT_BOT_ID_DEV=
SLACK_ALERT_BOT_ID_PROD=
