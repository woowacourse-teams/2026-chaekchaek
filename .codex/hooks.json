{
  "description": "Guard actual Chaekchaek UI and Pencil edits.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__pencil__execute$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/design_system_guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking Chaekchaek design tokens"
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/design_system_guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking design-first UI gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__pencil__get_screenshot$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/design_system_guard.py\"",
            "timeout": 5,
            "statusMessage": "Recording verified UI draft"
          }
        ]
      }
    ]
  }
}
