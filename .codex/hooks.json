{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "project_hook_root=$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\") && /usr/bin/python3 \"$project_hook_root/.codex/hooks/chaekchaek-design-system-guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking Chaekchaek design system"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "project_hook_root=$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\") && /usr/bin/python3 \"$project_hook_root/.codex/hooks/chaekchaek-design-system-guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "project_hook_root=$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\") && /usr/bin/python3 \"$project_hook_root/.codex/hooks/chaekchaek-design-system-guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking Chaekchaek UI task"
          }
        ]
      }
    ]
  }
}
