logging {
  level  = "info"
  format = "logfmt"
}

prometheus.scrape "backend" {
  targets = [
    {"__address__" = sys.env("BACKEND_CONTAINER") + ":9090"},
  ]
  metrics_path    = "/actuator/prometheus"
  scrape_interval = "15s"
  job_name        = "chaekchaek-backend"
  forward_to      = [prometheus.remote_write.monitoring.receiver]
}

prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "15s"
  job_name        = "host"
  forward_to      = [prometheus.remote_write.monitoring.receiver]
}

prometheus.exporter.mysql "db" {
  data_source_name = sys.env("MYSQL_EXPORTER_DSN")
}

prometheus.scrape "db" {
  targets         = prometheus.exporter.mysql.db.targets
  scrape_interval = "15s"
  job_name        = "mysql"
  forward_to      = [prometheus.remote_write.monitoring.receiver]
}

prometheus.remote_write "monitoring" {
  external_labels = {"env" = sys.env("APP_ENV")}

  endpoint {
    url = sys.env("MONITORING_PROM_URL")
  }
}

discovery.docker "backend" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "name"
    values = [sys.env("BACKEND_CONTAINER")]
  }
}

discovery.relabel "backend_logs" {
  targets = []
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "backend" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.backend.targets
  relabel_rules = discovery.relabel.backend_logs.rules
  labels        = {"app" = "chaekchaek", "env" = sys.env("APP_ENV")}
  forward_to    = [loki.write.monitoring.receiver]
}

loki.write "monitoring" {
  endpoint {
    url = sys.env("MONITORING_LOKI_URL")
  }
}
