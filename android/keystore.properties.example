# Copy this file to keystore.properties. It is intentionally ignored by Git.
# Get the .jks file from the team Google Drive and the values from the private Slack channel.
# Use an absolute path; Gradle does not expand ~ in this property.
storeFile=/absolute/path/to/chaekchaek-upload.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=chaekchaek-upload
keyPassword=YOUR_KEY_PASSWORD
