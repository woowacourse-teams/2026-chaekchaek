{
  "request": {
    "method": "GET",
    "urlPath": "/v1/goods/itemList",
    "headers": {
      "X-Api-Key": {
        "equalTo": "load-test-key"
      }
    },
    "queryParameters": {
      "category": {
        "equalTo": "BOOK"
      },
      "page": {
        "equalTo": "2"
      },
      "pageSize": {
        "equalTo": "10"
      },
      "detail": {
        "equalTo": "N"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "item-list-page-2.json",
    "fixedDelayMilliseconds": 200
  }
}
