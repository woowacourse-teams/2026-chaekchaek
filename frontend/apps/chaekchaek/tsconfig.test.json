{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "vitest/importMeta",
      "vitest/jsdom",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    "./src/**/*.test.ts",
    "./src/**/*.test.tsx",
    "./src/**/*.spec.ts",
    "./src/**/*.spec.tsx",
    "./src/test/**/*.ts",
    "./src/test/**/*.tsx",
    "./vitest.config.ts"
  ]

}